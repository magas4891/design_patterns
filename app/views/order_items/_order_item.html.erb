<div id="<%= dom_id order_item %>" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-3.5 border-b border-slate-100 bg-slate-50/80">
    <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Order Item Details</h2>
  </div>
  <dl class="divide-y divide-slate-100">
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Order</dt>
      <dd class="col-span-2">
        <code class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded">#<%= order_item.order_id %></code>
      </dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Product</dt>
      <dd class="col-span-2">
        <code class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded">#<%= order_item.product_id %></code>
      </dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Quantity</dt>
      <dd class="col-span-2 text-sm font-semibold text-slate-800"><%= order_item.quantity %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Unit Price</dt>
      <dd class="col-span-2 text-sm font-semibold text-slate-800"><%= number_to_currency(order_item.unit_price_cents / 100.0) %></dd>
    </div>
  </dl>
</div>

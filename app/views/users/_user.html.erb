<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

  <div>
    <strong>Role:</strong>
    <%= user.role_label %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= user.status_label %>
  </div>

</div>

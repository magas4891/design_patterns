<% content_for :title, "Edit Payment" %>

<div class="flex items-center gap-1.5 text-sm text-slate-400 mb-5">
  <%= link_to "Payments", payments_path, class: "hover:text-slate-600 transition-colors" %>
  <span>/</span>
  <%= link_to "Payment \##{@payment.id}", @payment, class: "hover:text-slate-600 transition-colors" %>
  <span>/</span>
  <span class="text-slate-600 font-medium">Edit</span>
</div>

<div class="max-w-lg">
  <h1 class="text-2xl font-bold text-slate-800 mb-5">Edit Payment #<%= @payment.id %></h1>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
    <%= render "form", payment: @payment %>
  </div>
</div>

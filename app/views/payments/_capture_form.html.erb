<%= form_with(model: form_object, url: payments_path) do |form| %>
  <% if form_object.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(form_object.errors.count, "error") %> prohibited this payment from being captured:</h2>

      <ul>
        <% form_object.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p style="margin-bottom: 1rem;">
    Uses <code>Payments::CapturePaymentForm</code> → <code>Payments::CaptureService</code> (stub gateway).
    Order must be in <strong>placed</strong> status. Use token <code>ok</code> to succeed, <code>fail</code> to simulate decline.
  </p>

  <div>
    <%= form.label :order_id, "Order ID", style: "display: block" %>
    <%= form.number_field :order_id %>
  </div>

  <div>
    <%= form.label :source_token, style: "display: block" %>
    <%= form.text_field :source_token %>
  </div>

  <div>
    <%= form.label :provider, style: "display: block" %>
    <%= form.text_field :provider, placeholder: "fake_gateway (default)" %>
  </div>

  <div>
    <%= form.submit "Capture payment" %>
  </div>
<% end %>

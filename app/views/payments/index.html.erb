<% content_for :title, "Payments" %>

<div class="flex items-start justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-800">Payments</h1>
    <p class="text-sm text-slate-500 mt-0.5">Payment transactions</p>
  </div>
  <%= link_to "Capture Payment", new_payment_path, class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors" %>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <table class="w-full">
    <thead class="bg-slate-50 border-b border-slate-200">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Order</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Provider</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Amount</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Paid At</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if @payments.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-12 text-center text-sm text-slate-400">No payments yet.</td>
        </tr>
      <% else %>
        <% @payments.each do |payment| %>
          <tr class="hover:bg-slate-50/70 transition-colors">
            <td class="px-4 py-3">
              <code class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">#<%= payment.order_id %></code>
            </td>
            <td class="px-4 py-3 text-sm text-slate-600"><%= payment.provider %></td>
            <td class="px-4 py-3"><%= status_badge(payment.status, payment.status_label) %></td>
            <td class="px-4 py-3 text-sm font-medium text-slate-700"><%= payment.formatted_amount %></td>
            <td class="px-4 py-3 text-sm text-slate-500"><%= payment.formatted_paid_at || "—" %></td>
            <td class="px-4 py-3 text-right space-x-3">
              <%= link_to "View", payment, class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" %>
              <%= link_to "Edit", edit_payment_path(payment), class: "text-slate-400 hover:text-slate-600 text-sm" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<%= form_with(model: payment) do |form| %>
  <% if payment.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(payment.errors.count, "error") %> prohibited this payment from being saved:</h2>

      <ul>
        <% payment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :order_id, style: "display: block" %>
    <%= form.text_field :order_id %>
  </div>

  <div>
    <%= form.label :provider, style: "display: block" %>
    <%= form.text_field :provider %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.label :amount_cents, style: "display: block" %>
    <%= form.number_field :amount_cents %>
  </div>

  <div>
    <%= form.label :transaction_id, style: "display: block" %>
    <%= form.text_field :transaction_id %>
  </div>

  <div>
    <%= form.label :paid_at, style: "display: block" %>
    <%= form.datetime_field :paid_at %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

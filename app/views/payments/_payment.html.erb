<div id="<%= dom_id payment %>">
  <div>
    <strong>Order:</strong>
    <%= payment.order_id %>
  </div>

  <div>
    <strong>Provider:</strong>
    <%= payment.provider %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= payment.status %>
  </div>

  <div>
    <strong>Amount cents:</strong>
    <%= payment.amount_cents %>
  </div>

  <div>
    <strong>Transaction:</strong>
    <%= payment.transaction_id %>
  </div>

  <div>
    <strong>Paid at:</strong>
    <%= payment.paid_at %>
  </div>

</div>

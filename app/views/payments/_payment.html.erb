<div id="<%= dom_id payment %>" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-3.5 border-b border-slate-100 bg-slate-50/80">
    <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Payment Details</h2>
  </div>
  <dl class="divide-y divide-slate-100">
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Order</dt>
      <dd class="col-span-2">
        <code class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded">#<%= payment.order_id %></code>
      </dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Provider</dt>
      <dd class="col-span-2 text-sm text-slate-700"><%= payment.provider %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Status</dt>
      <dd class="col-span-2"><%= status_badge(payment.status, payment.status_label) %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Amount</dt>
      <dd class="col-span-2 text-sm font-semibold text-slate-800"><%= payment.formatted_amount %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Transaction ID</dt>
      <dd class="col-span-2">
        <code class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded"><%= payment.transaction_id || "—" %></code>
      </dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Paid At</dt>
      <dd class="col-span-2 text-sm text-slate-700"><%= payment.formatted_paid_at || "—" %></dd>
    </div>
  </dl>
</div>

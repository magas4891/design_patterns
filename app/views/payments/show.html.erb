<% content_for :title, "Payment \##{@payment.id}" %>

<div class="flex items-start justify-between mb-6">
  <div>
    <div class="flex items-center gap-1.5 text-sm text-slate-400 mb-2">
      <%= link_to "Payments", payments_path, class: "hover:text-slate-600 transition-colors" %>
      <span>/</span>
      <span class="text-slate-600 font-medium">Payment #<%= @payment.id %></span>
    </div>
    <h1 class="text-2xl font-bold text-slate-800">Payment #<%= @payment.id %></h1>
  </div>
  <div class="flex items-center gap-2 pt-1">
    <%= link_to "Edit", edit_payment_path(@payment), class: "px-4 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors" %>
    <%= link_to "Delete", @payment, data: { turbo_method: :delete, turbo_confirm: "Delete this payment?" }, class: "px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors" %>
  </div>
</div>

<%= render @payment %>

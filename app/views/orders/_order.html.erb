<div id="<%= dom_id order %>">
  <div>
    <strong>User:</strong>
    <%= order.user_name %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= order.status_label %>
  </div>

  <div>
    <strong>Total:</strong>
    <%= order.formatted_total %>
  </div>

  <div>
    <strong>Placed at:</strong>
    <%= order.formatted_placed_at %>
  </div>

</div>

<%= form_with(model: form_object) do |form| %>
  <% if form_object.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(form_object.errors.count, "error") %> prohibited this order from being saved:</h2>

      <ul>
        <% form_object.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.label :total_cents, style: "display: block" %>
    <%= form.number_field :total_cents %>
  </div>

  <div>
    <%= form.label :placed_at, style: "display: block" %>
    <%= form.datetime_field :placed_at %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

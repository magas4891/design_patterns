<%= form_with(model: form_object) do |form| %>
  <% if form_object.errors.any? %>
    <div class="mb-5 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-sm font-semibold text-red-800 mb-2">
        <%= pluralize(form_object.errors.count, "error") %> prevented saving:
      </h3>
      <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
        <% form_object.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= form.label :user_id, "User ID", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.text_field :user_id, class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.text_field :status, placeholder: "cart / placed / paid / cancelled", class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder:text-slate-400" %>
    </div>
    <div>
      <%= form.label :total_cents, "Total (cents)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.number_field :total_cents, class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :placed_at, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.datetime_field :placed_at, class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
    <div class="pt-1">
      <%= form.submit class: "px-5 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>

<% content_for :title, "Products" %>

<div class="flex items-start justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-800">Products</h1>
    <p class="text-sm text-slate-500 mt-0.5">Manage your product catalog</p>
  </div>
  <%= link_to "New Product", new_product_path, class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors" %>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <table class="w-full">
    <thead class="bg-slate-50 border-b border-slate-200">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Name</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Price</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Category</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if @products.empty? %>
        <tr>
          <td colspan="5" class="px-4 py-12 text-center text-sm text-slate-400">No products yet.</td>
        </tr>
      <% else %>
        <% @products.each do |product| %>
          <tr class="hover:bg-slate-50/70 transition-colors">
            <td class="px-4 py-3 text-sm font-semibold text-slate-800"><%= product.name %></td>
            <td class="px-4 py-3 text-sm font-medium text-slate-600"><%= product.formatted_price %></td>
            <td class="px-4 py-3"><%= status_badge(product.status, product.status_label) %></td>
            <td class="px-4 py-3 text-sm text-slate-500"><%= product.category_name %></td>
            <td class="px-4 py-3 text-right space-x-3">
              <%= link_to "View", product, class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" %>
              <%= link_to "Edit", edit_product_path(product), class: "text-slate-400 hover:text-slate-600 text-sm" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

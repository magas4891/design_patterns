<%= form_with(model: form_object) do |form| %>
  <% if form_object.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(form_object.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
        <% form_object.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :price_cents, style: "display: block" %>
    <%= form.number_field :price_cents %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.label :category_id, style: "display: block" %>
    <%= form.text_field :category_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= product.formatted_price %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= product.status_label %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= product.category_name %>
  </div>

</div>

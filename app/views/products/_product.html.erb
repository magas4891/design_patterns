<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

  <div>
    <strong>Price cents:</strong>
    <%= product.price_cents %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= product.status %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= product.category_id %>
  </div>

</div>

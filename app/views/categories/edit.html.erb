<% content_for :title, "Edit Category" %>

<div class="flex items-center gap-1.5 text-sm text-slate-400 mb-5">
  <%= link_to "Categories", categories_path, class: "hover:text-slate-600 transition-colors" %>
  <span>/</span>
  <%= link_to @category.name, @category, class: "hover:text-slate-600 transition-colors" %>
  <span>/</span>
  <span class="text-slate-600 font-medium">Edit</span>
</div>

<div class="max-w-lg">
  <h1 class="text-2xl font-bold text-slate-800 mb-5">Edit Category</h1>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
    <%= render "form", category: @category %>
  </div>
</div>

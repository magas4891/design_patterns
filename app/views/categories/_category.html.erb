<div id="<%= dom_id category %>" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-3.5 border-b border-slate-100 bg-slate-50/80">
    <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Category Details</h2>
  </div>
  <dl class="divide-y divide-slate-100">
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Name</dt>
      <dd class="col-span-2 text-sm font-semibold text-slate-800"><%= category.name %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-6 py-4">
      <dt class="text-sm font-medium text-slate-500">Slug</dt>
      <dd class="col-span-2">
        <code class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded"><%= category.slug %></code>
      </dd>
    </div>
  </dl>
</div>

<%= form_with(model: category) do |form| %>
  <% if category.errors.any? %>
    <div class="mb-5 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-sm font-semibold text-red-800 mb-2">
        <%= pluralize(category.errors.count, "error") %> prevented saving:
      </h3>
      <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.text_field :name, class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :slug, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.text_field :slug, placeholder: "auto-generated from name", class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder:text-slate-400" %>
    </div>
    <div class="pt-1">
      <%= form.submit class: "px-5 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>
